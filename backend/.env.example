# Database connection (SQLite is used for the local prototype; Postgres is supported)
DATABASE_URL=sqlite:///evidence_platform.db
# DATABASE_URL=postgresql://postgres:localpassword@localhost:5432/evidence_platform

# Redis cache and rate limiting connection (optional for local use)
REDIS_URL=redis://localhost:6379/0

# Qdrant: leave QDRANT_HOST empty to auto-start the bundled qdrant.exe
# (backend/qdrant_bin) with storage in backend/qdrant_native_data.
QDRANT_HOST=
QDRANT_PORT=6333
QDRANT_API_KEY=

# NCBI API Settings (only needed for corpus ingestion)
NCBI_API_KEY=
NCBI_EMAIL=

# ML / AI providers
#   EMBEDDING_PROVIDER: bge-m3 | mock
#   RERANKER_PROVIDER:  bge-reranker | mock
#   LLM_PROVIDER: openrouter | mock
#   ENTAILMENT_PROVIDER: gemini-decision (Gemini Decisions API, falls back to the chat chain) | openrouter | mock
EMBEDDING_PROVIDER=bge-m3
RERANKER_PROVIDER=bge-reranker
LLM_PROVIDER=openrouter
ENTAILMENT_PROVIDER=gemini-decision
LLM_API_KEY=
LLM_MODEL_NAME=gemini:gemini-2.5-flash,gemini:gemini-3.5-flash,gemini:gemini-3.6-flash,gemini:gemini-3.5-flash-lite,gemini:gemini-3.1-flash-lite,gemini:gemini-3.8-flash,gemini:gemini-3.7-flash,gemini:gemini-flash-latest,nvidia/nemotron-3-ultra-550b-a55b:free
# Optional: a faster/cheaper model for per-claim NLI checks (defaults to LLM_MODEL_NAME)
ENTAILMENT_MODEL_NAME=gemini:gemini-3.1-flash-lite,gemini:gemini-3.5-flash-lite,gemini:gemini-flash-lite-latest,gemini:gemma-4-26b-a4b-it,baidu/ernie-5.5-flash-preview:free
LLM_TIMEOUT_S=90
# Optional extra FREE providers (no card needed); add a key to extend the chain,
# e.g. LLM_MODEL_NAME=...,gemini:gemini-2.5-flash
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# App Security Settings
SESSION_SECRET_KEY=local_development_secret_key_32_chars_long
JWT_SECRET_KEY=local_development_jwt_secret_key
CSRF_SECRET_KEY=local_development_csrf_secret_key
